<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dorai_simulator</name>
  <version>0.1.0</version>
  <description>
    The ROS 2 side of the DorAI virtual acoustic lab: plays a scene rendered by
    simulator/acoustic (pyroomacoustics) into the graph as the Artaban robot's
    microphones, and publishes the truth to score every module against.
  </description>
  <maintainer email="info@sensifai.com">Sensifai</maintainer>
  <license>None</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <!-- pip: numpy scipy soundfile. Scenes are rendered beforehand, without ROS,
       by simulator/acoustic (which needs pyroomacoustics). -->
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
