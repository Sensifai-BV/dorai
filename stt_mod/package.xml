<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>stt_mod</name>
  <version>0.2.0</version>
  <description>
    Stage 2 of the dorai pipeline: streaming speech-to-text with NVIDIA
    nemotron-speech-streaming-en-0.6b (NeMo, run via sherpa-onnx), optional dorai
    fine-tuned encoder adapters.
  </description>
  <maintainer email="info@sensifai.com">Sensifai</maintainer>
  <license>None</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>rcl_interfaces</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- sherpa-onnx is pip-only: pip install sherpa-onnx (see README) -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
